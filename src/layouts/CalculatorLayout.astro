---
import BaseLayout from "@/layouts/BaseLayout.astro"
import AdSlot from "@/components/AdSlot.astro"
import { getCalculator, relatedCalculators } from "@/data/calculators"

interface FaqItem {
  q: string
  a: string
}

interface Props {
  title: string
  description: string
  heading: string
  intro: string
  slug: string
  faqs: FaqItem[]
  canonical?: string
  breadcrumbLabel?: string
  relatedSlugs?: string[]
}

const {
  title,
  description,
  heading,
  intro,
  slug,
  faqs,
  canonical,
  breadcrumbLabel,
  relatedSlugs,
} = Astro.props
const requestedRelated = relatedSlugs
  ?.map((relatedSlug) => getCalculator(relatedSlug))
  .filter((calculator) => calculator !== undefined)
const related = requestedRelated?.length
  ? requestedRelated
  : relatedCalculators(slug, 4)

const faqJsonLd = {
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
}

const jsonLd = breadcrumbLabel
  ? {
      "@context": "https://schema.org",
      "@graph": [
        faqJsonLd,
        {
          "@type": "BreadcrumbList",
          itemListElement: [
            {
              "@type": "ListItem",
              position: 1,
              name: "Health Calculators",
              item: "https://health.zaleastudio.com/",
            },
            {
              "@type": "ListItem",
              position: 2,
              name: breadcrumbLabel,
              item: canonical,
            },
          ],
        },
      ],
    }
  : { "@context": "https://schema.org", ...faqJsonLd }
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  {
    breadcrumbLabel && (
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Health Calculators</a></li>
          <li aria-current="page">{breadcrumbLabel}</li>
        </ol>
      </nav>
    )
  }

  <div class="page-intro">
    <p class="eyebrow">Health Calculator</p>
    <h1>{heading}</h1>
    <p class="lead">{intro}</p>
  </div>

  <div class="calc-layout" style="margin-top:2rem;">
    <div>
      <!-- Calculator tool goes here -->
      <slot name="tool" />

      {
        Astro.slots.has("content") ? (
          <>
            <slot name="content" />
            <AdSlot variant="horizontal" label="Advertisement space (responsive)" />
          </>
        ) : (
          <>
            <!-- Formula explanation -->
            <section class="prose" aria-labelledby="formula-heading">
              <h2 id="formula-heading">How it works</h2>
              <slot name="formula" />
            </section>

            <AdSlot variant="horizontal" label="Advertisement space (responsive)" />

            <!-- Worked example -->
            <section class="prose" aria-labelledby="example-heading">
              <h2 id="example-heading">Example calculation</h2>
              <div class="example-box">
                <slot name="example" />
              </div>
            </section>
          </>
        )
      }

      <!-- FAQ -->
      <section class="faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading">Frequently asked questions</h2>
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </section>

      <!-- Related calculators -->
      <section class="related" aria-labelledby="related-heading">
        <h2 id="related-heading">Related calculators</h2>
        <ul class="related-links">
          {
            related.map((c) => (
              <li>
                <a href={`/calculators/${c.slug}/`}>{c.name}</a>
              </li>
            ))
          }
        </ul>
      </section>

      <p class="disclaimer-note">
        This tool is for general educational purposes only and does not provide
        medical advice, diagnosis, or treatment. Talk to a qualified healthcare
        professional before making health decisions. Read our
        <a href="/disclaimer">health disclaimer</a>.
      </p>
    </div>

    <div class="sidebar">
      <AdSlot label="Advertisement space" />
      <AdSlot label="Advertisement space" />
    </div>
  </div>
</BaseLayout>
